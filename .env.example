# ==============================================================================
# FormQR Studio - Variabel Lingkungan & Konfigurasi Runtime
# ==============================================================================
# Salin file ini menjadi .env jika ingin mengubah konfigurasi server dev lokal:
# cp .env.example .env

# Port server pengembangan lokal (Vite)
PORT=3000

# Mode Aplikasi (development / production)
NODE_ENV=production

# Base URL publik (kosongkan jika dideploy di root domain, atau isi misal /formqr/)
VITE_PUBLIC_BASE_PATH=/
