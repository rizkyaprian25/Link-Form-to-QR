# ==============================================================================
# FormQR Studio - Variabel Lingkungan & Konfigurasi Runtime
# ==============================================================================
# Salin berkas ini menjadi .env untuk mengaktifkan koneksi ke Neon Database:
# cp .env.example .env

# Port server pengembangan lokal (Vite)
PORT=3000

# Mode Aplikasi (development / production)
NODE_ENV=production

# URL Basis Publik
VITE_PUBLIC_BASE_PATH=/

# ==============================================================================
# NEON POSTGRESQL DATABASE (Serverless Cloud Database)
# ==============================================================================
# Ambil Connection String dari Neon Console (https://console.neon.tech):
# Pastikan menggunakan format postgresql:// dengan ?sslmode=require
DATABASE_URL="postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"
